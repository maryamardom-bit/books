# Copy to .env (development) or .env.prod (production) and fill in real values.
# Production: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production example: https://kasra-pub.ir,https://www.kasra-pub.ir
# DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

DJANGO_DB_NAME=postgres
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=postgres
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# Unset = local-memory cache. Production: redis://redis:6379/1
# REDIS_URL=

# Payment (SEP). Store prices are Toman; the multiplier converts to Rial for the gateway.
PAYMENT_GATEWAY=sep
SEP_TERMINAL_ID=your-terminal-id
PAYMENT_AMOUNT_MULTIPLIER=10
PAYMENT_HTTP_TIMEOUT=15

# SMS (Kavenegar). SMS_ENABLED defaults to False while the key is the placeholder.
KAVENEGAR_API_KEY=test_api_key
KAVENEGAR_SENDER=1000596446
# SMS_ENABLED=True

# API rate limits
API_THROTTLE_ANON=60/minute
API_THROTTLE_USER=240/minute

# Production only (config.settings_production)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=2592000
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=no-reply@kasra-pub.ir
